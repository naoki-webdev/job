VITE_API_BASE_URL=http://localhost:3000
# ローカルのDocker環境では、docker-compose.ymlのDB_HOSTとDB_DATABASEを使います。
# ローカルではDATABASE_URLを設定しないでください。設定するとRailsがそちらを優先します。
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=job_compare_development
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=password
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=password
GEMINI_API_KEY=
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=
ADMIN_USER_NAME=
